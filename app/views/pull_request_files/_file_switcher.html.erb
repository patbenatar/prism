<%#
  The Markdown files in this pull request, as a jump menu.

  It used to navigate; now every file is already on the page, so each row is a
  plain fragment link to that file's section. That means it works with no
  JavaScript at all — the browser's own anchor scrolling does the work, and
  `scroll-margin-top` on the section keeps the landing clear of the two pinned
  bars. `file-nav` adds only what the browser can't: which file you are
  currently reading, in the summary and as `aria-current` in the list.

  A native <details>, so it opens without JavaScript too; the `menu`
  controller adds outside-click and Escape closing.

  Locals: page (Review::PullRequestPage)
%>
<details class="relative min-w-0 shrink" data-controller="menu" data-testid="file-switcher">
  <summary class="flex min-w-0 cursor-pointer list-none items-center gap-1.5 rounded-lg px-2 py-1 hover:bg-sunk"
           aria-haspopup="menu">
    <span class="sr-only">Jump to a Markdown file in this pull request.</span>
    <span class="min-w-0 truncate font-mono text-xs" aria-hidden="true"
          data-file-nav-target="label"><%= count_of(page.markdown_files.size, "Markdown file") %></span>
    <span class="shrink-0 text-xs text-ink-faint tnum" aria-hidden="true"
          data-file-nav-target="position"></span>
    <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 shrink-0 text-ink-faint" aria-hidden="true">
      <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
    </svg>
  </summary>

  <div class="absolute left-0 z-40 mt-2 max-h-[70vh] w-[22rem] max-w-[calc(100vw-2rem)] overflow-auto rounded-xl border border-line bg-surface shadow-lg shadow-ink/5"
       role="menu" data-testid="file-switcher-menu">
    <% page.markdown_files.each do |candidate| %>
      <% status_word, status_class = file_status_label(candidate.status) %>
      <% candidate_dir, candidate_base = split_path(candidate.path) %>
      <%# `turbo: false` is what makes the jump reliable. Turbo treats a
          same-page "#fragment" click as a visit and re-renders the body from
          its snapshot cache, which throws away everything the page is holding
          in the DOM — an open composer, half-typed text, and the switcher's
          own idea of which file you are in. Opted out, the browser scrolls to
          the anchor natively and nothing is lost. %>
      <%= link_to "##{Review::Page.file_key(candidate.path)}",
                  class: "flex items-start gap-2.5 border-b border-line px-3 py-2 last:border-b-0 hover:bg-sunk aria-[current=true]:bg-brand-soft/60",
                  role: "menuitem",
                  data: { testid: "file-switcher-item", file_nav_target: "item",
                          file_key: Review::Page.file_key(candidate.path),
                          turbo: false, action: "file-nav#jump" } do %>
        <span class="<%= status_class %> mt-0.5 shrink-0"><%= status_word %></span>
        <span class="min-w-0 flex-1 font-mono text-xs break-all">
          <% if candidate_dir %><span class="text-ink-faint"><%= candidate_dir %></span><% end %><span class="font-medium text-ink"><%= candidate_base %></span>
        </span>
        <span class="mt-0.5 shrink-0"><%= diffstat(candidate.additions, candidate.deletions) %></span>
      <% end %>
    <% end %>
  </div>
</details>

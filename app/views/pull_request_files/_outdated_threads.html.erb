<%#
  Threads GitHub can no longer place in the file: `isOutdated`, or a thread
  whose `line` came back null because newer commits moved the code.

  Prism never guesses which block these belong to — a wrong guess reads as a
  comment about text nobody wrote. It shows the line they were left on and the
  diff hunk GitHub kept with them, and links out.

  Locals: outdated, unplaced ([Github::Types::ReviewThread]), pull_request
%>
<% threads = Array(outdated) + Array(unplaced) %>

<% if threads.any? %>
  <section id="outdated_threads" class="md-row mt-10" aria-labelledby="outdated-heading"
           data-testid="outdated-threads">
    <div class="md-gutter" aria-hidden="true"></div>

    <div class="md-body">
      <details class="overflow-hidden rounded-xl border border-modified/30 bg-surface"
               data-controller="collapse">
        <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-2.5">
          <span class="pill-modified">Outdated</span>
          <h2 class="font-display text-sm font-medium text-ink" id="outdated-heading">
            <%= count_of(threads.size, "thread") %> GitHub can no longer place
          </h2>
          <span class="flex-1"></span>
          <span class="text-xs text-ink-faint" data-collapse-target="label">Show</span>
        </summary>

        <div class="space-y-5 border-t border-line px-4 py-3">
          <% threads.each do |thread| %>
            <div data-testid="outdated-thread">
              <p class="text-xs text-ink-faint">
                <% line = thread.original_line || thread.line %>
                <% if line %>
                  Left on line <span class="tnum"><%= line %></span><%= thread.left_side? ? " of the removed side" : "" %>.
                <% else %>
                  Left on a line that is no longer in the diff.
                <% end %>
              </p>

              <% hunk = thread.comments.first&.diff_hunk %>
              <% if hunk.present? %>
                <pre class="mt-1.5 overflow-x-auto rounded-lg border border-line bg-sunk p-3 font-mono text-xs leading-relaxed text-ink-soft"
                     data-testid="diff-hunk"><%= hunk %></pre>
              <% end %>

              <%= render "thread", thread: thread, pull_request: pull_request,
                                   block_id: "outdated" %>
            </div>
          <% end %>
        </div>
      </details>
    </div>
  </section>
<% end %>

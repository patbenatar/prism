<%#
  One top-level block of the document: its change bar, its "+", its rendered
  HTML (with child markers woven in), the threads already on it, and the empty
  slot the composer opens into.

  Every id here is prefixed with the file's key, because the page holds every
  Markdown file in the pull request and Markdown::Renderer numbers blocks from
  zero per document. See PullRequestFilesHelper#block_dom_id.

  Locals: annotated (Review::AnnotatedBlock), pull_request, page (Review::Page)
%>
<% block = annotated.block %>
<% dom_id = block_dom_id(block, page.file_key) %>
<% removed_file = page.result.removed_file? %>
<% change = removed_file ? "removed" : annotated.change.to_s %>

<%# Content this pull request deleted, shown where it used to be. %>
<% if annotated.removed_before? %>
  <%= render "removed_strip", blocks: annotated.removed_before, page: page,
                              pull_request: pull_request %>
<% end %>

<div class="md-block <%= "md-block--#{change}" unless change == "unchanged" %>"
     id="block_<%= dom_id %>"
     data-block-id="<%= dom_id %>"
     data-change="<%= change %>"
     data-commentable="<%= annotated.commentable? %>"
     data-start-line="<%= block.start_line %>"
     data-end-line="<%= block.end_line %>"
     data-block-type="<%= block.type %>"
     data-testid="md-block">
  <div class="md-gutter">
    <span class="md-gutter-bar" aria-hidden="true"></span>
    <%= gutter_button(annotated, path: page.path) %>
  </div>

  <div class="md-body md-prose">
    <%= block_body(annotated, pull_request: pull_request, path: page.path) %>

    <div id="threads_<%= dom_id %>" class="md-threads">
      <% annotated.threads.each do |thread| %>
        <%= render "thread", thread: thread, pull_request: pull_request, block_id: dom_id %>
      <% end %>
    </div>

    <div id="composer_<%= dom_id %>" class="md-composer"></div>
  </div>
</div>

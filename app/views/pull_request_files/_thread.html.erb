<%#
  One review thread, under the block it belongs to.

  Workstream E owns the real thread card — replies, resolve/unresolve, edit,
  delete, reactions — as `review_comments/_thread`. This partial is the single
  place the file view names it, and it falls back to a read-only card until E's
  lands, so the read path is never blocked on the write path.

  Locals: thread (Github::Types::ReviewThread), pull_request, block_id
%>
<%# `@pending_review` rather than a local: GitHub allows exactly one pending
    review per user per pull request, so it is a fact about the page, not
    about the file a thread happens to be in. %>
<% if review_partial?("review_comments/thread") %>
  <%= render "review_comments/thread", thread: thread, pull_request: pull_request,
                                       block_id: block_id,
                                       pending_review: @pending_review %>
<% else %>
  <% pending = thread.comments.any?(&:pending?) %>
  <article class="thread <%= class_names("thread--pending" => pending,
                                         "thread--resolved" => thread.resolved?,
                                         "thread--outdated" => thread.outdated?) %>"
           id="thread_<%= thread.node_id %>"
           data-block-id="<%= block_id %>"
           data-testid="thread">
    <% if thread.resolved? %>
      <details data-controller="collapse">
        <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-2 text-xs text-ink-faint">
          <span class="pill-resolved">Resolved</span>
          <span>
            by <%= thread.resolved_by&.login || "someone" %> ·
            <%= count_of(thread.comments.size, "comment") %>
          </span>
          <span class="flex-1"></span>
          <span data-collapse-target="label">Show</span>
        </summary>
        <div class="border-t border-line">
          <% thread.comments.each do |comment| %>
            <div id="comment_<%= comment.node_id %>">
              <%= render "shared/comment_card", comment: comment %>
            </div>
          <% end %>
        </div>
      </details>
    <% else %>
      <% if thread.left_side? %>
        <p class="border-b border-line bg-sunk/60 px-4 py-1.5 text-xs text-ink-faint">
          On content this pull request removed.
        </p>
      <% end %>
      <% thread.comments.each do |comment| %>
        <div id="comment_<%= comment.node_id %>">
          <%= render "shared/comment_card", comment: comment %>
        </div>
      <% end %>
    <% end %>
  </article>
<% end %>

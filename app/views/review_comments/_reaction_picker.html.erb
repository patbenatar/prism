<%#
  The interactive half of a comment's reactions. `_comment_card` (shared)
  already prints a read-only summary of counts; these are the clickable
  controls that add or remove the viewer's own reaction, so "the reaction
  pills toggle based on viewer_has_reacted" (PLAN.md) holds even though the
  shared card's own pills carry no behavior.

  The trigger is a bare icon rather than a bordered box: reacting is an
  invitation, not a control with standing, and it sits in the quietest row on
  the card (DESIGN.md §8).

  Locals: comment: (required), thread_id:
%>
<% comment = local_assigns.fetch(:comment) %>
<% groups = comment.reaction_groups.index_by(&:content) %>
<% owner = params[:owner]; repo = params[:repo]; number = params[:number] %>

<details class="reaction-picker relative inline-block" data-testid="reaction-picker">
  <summary class="reaction-add" aria-label="Add a reaction">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
         stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
      <path d="M13.4 7.3a5.7 5.7 0 1 1-4.7-4.7" />
      <path d="M5.6 9.4a3 3 0 0 0 4.3 0" />
      <path d="M5.9 6.4h.01M9.7 6.4h.01" />
      <path d="M12.4 1.9v3.2M14 3.5h-3.2" />
    </svg>
  </summary>
  <div class="reaction-menu">
    <% Github::Client::REACTIONS.each_key do |content| %>
      <% group = groups[content] %>
      <% on = group&.viewer_has_reacted? %>
      <%= button_to (on ? repo_pull_comment_reaction_path(owner: owner, repo: repo, number: number, id: comment.node_id, reaction_id: content) : repo_pull_comment_reactions_path(owner: owner, repo: repo, number: number, id: comment.node_id)),
                     method: (on ? :delete : :post),
                     params: { content: content, thread_id: thread_id },
                     class: "reaction-pill #{'reaction-pill--on' if on}",
                     form: { data: { turbo: true } },
                     data: { testid: "reaction-#{content}" } do %>
        <span aria-hidden="true"><%= reaction_emoji(content) %></span>
        <span class="sr-only"><%= content %></span>
      <% end %>
    <% end %>
  </div>
</details>

<%#
  Swapped in for a comment's body by comment_actions_controller.js when its
  Edit button is clicked — no round trip needed to show the form, since both
  panes are rendered up front and toggled client-side. Same `.composer-card`
  as the composer and the reply box, so editing looks like the thing you are
  editing (DESIGN.md §8).

  Locals:
    comment:   (required)
    thread_id: (required) the owning thread's GraphQL node id. Carried as a
               hidden field so a save re-render still has it, matching
               _reply_form's `f.hidden_field :thread_id`; without it,
               ReviewCommentsController#update re-renders the comment card
               with a blank thread_id, and the next Delete on that same
               comment can no longer find the thread to remove or replace.
%>
<% comment = local_assigns.fetch(:comment) %>
<% thread_id = local_assigns.fetch(:thread_id) %>

<%= form_with url: repo_pull_comment_path(owner: params[:owner], repo: params[:repo], number: params[:number], id: comment.node_id),
              method: :patch, class: "composer-card block",
              data: { turbo: true, testid: "comment-edit-form" } do |f| %>
  <%# `id: nil`: both panes of every comment on the page render up front,
      so this form exists once per comment. See `_composer_form`. %>
  <%= f.hidden_field :thread_id, value: thread_id, id: nil %>
  <div data-controller="markdown-preview autocomplete"
       data-markdown-preview-url-value="<%= repo_markdown_preview_path(owner: params[:owner], repo: params[:repo]) %>"
       data-autocomplete-mentionables-url-value="<%= repo_mentionables_path(owner: params[:owner], repo: params[:repo]) %>"
       data-autocomplete-references-url-value="<%= repo_references_path(owner: params[:owner], repo: params[:repo]) %>">
    <div class="composer-head" role="tablist" aria-label="Comment editor">
      <button type="button" role="tab" aria-selected="true" class="composer-tab tab-active"
              data-action="markdown-preview#showWrite" data-markdown-preview-target="writeTab">Write</button>
      <button type="button" role="tab" aria-selected="false" class="composer-tab"
              data-action="markdown-preview#showPreview" data-markdown-preview-target="previewTab">Preview</button>
    </div>

    <%# `relative` so the listbox below anchors to the textarea it belongs to
        rather than to whatever positioned ancestor happens to be nearest. %>
    <div class="relative" data-markdown-preview-target="writePane" role="tabpanel">
      <%= f.text_area :body, value: comment.body, rows: 3, id: nil, class: "composer-textarea w-full",
                       data: { testid: "comment-edit-textarea", markdown_preview_target: "textarea", autocomplete_target: "textarea",
                                action: "input->composer#autosize keydown->autocomplete#keydown input->autocomplete#input blur->autocomplete#close input->markdown-preview#dirty" },
                       aria: { label: "Edit comment" } %>
      <div data-autocomplete-target="list"
           class="absolute z-20 mt-1 max-h-56 w-max min-w-72 max-w-full overflow-auto rounded-lg border border-line bg-surface py-1 text-sm shadow-lg shadow-ink/5"
           hidden role="listbox"></div>
    </div>

    <div data-markdown-preview-target="previewPane" hidden role="tabpanel"
         class="composer-preview md-prose md-prose-compact">
      <p class="text-ink-faint" data-markdown-preview-target="previewBody">Nothing to preview yet.</p>
    </div>
  </div>

  <div class="composer-foot">
    <button type="button" class="btn btn-ghost btn-sm" data-action="comment-actions#cancelEdit" data-testid="comment-edit-cancel">Cancel</button>
    <%= f.submit "Save", class: "btn btn-primary btn-sm", data: { testid: "comment-edit-save" } %>
  </div>
<% end %>

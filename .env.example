# Copy to .env and adjust. docker-compose reads .env automatically.

# --- Postgres ---
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- GitHub OAuth (sign-in) ---
# Create a GitHub OAuth App at https://github.com/settings/developers with
# Authorization callback URL: http://localhost:3004/auth/github/callback
# Then paste its Client ID and Client Secret below. Sign-in is unavailable
# until these are set — nothing else in the app breaks.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Active Record Encryption (users.access_token) ---
# The GitHub OAuth token is encrypted at rest. These are throwaway DEVELOPMENT
# keys, safe to share because they only ever protect a local dev database.
# Generate your own for any real deployment with:
#   docker compose exec app bin/rails db:encryption:init
AR_ENCRYPTION_PRIMARY_KEY=hyKh9GdYEZhqeF98knnfauioens9NVyV
AR_ENCRYPTION_DETERMINISTIC_KEY=NK3AFpyI1hrBWF6895z1i216YDAhFudj
AR_ENCRYPTION_KEY_DERIVATION_SALT=d5LQbkepzCQ0I5ju3wLX5ONks9YeN5q4

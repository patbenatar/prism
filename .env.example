# Copy to .env and adjust. docker-compose reads .env automatically.

# --- Postgres ---
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- GitHub OAuth (sign-in) ---
# Create a GitHub OAuth App at https://github.com/settings/developers with
# Authorization callback URL: http://localhost:3004/auth/github/callback
# Then paste its Client ID and Client Secret below. Sign-in is unavailable
# until these are set — nothing else in the app breaks.
#
# They are needed at RUN time too, not only at sign-in: GitHub's access token
# lasts eight hours and Github::Credentials mints the replacement with these.
# Without them renewal raises Github::Unavailable, which signs nobody out.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Active Record Encryption (users.access_token, users.refresh_token) ---
# The GitHub OAuth token is encrypted at rest. These are throwaway DEVELOPMENT
# keys, safe to share because they only ever protect a local dev database.
# Generate your own for any real deployment with:
#   docker compose exec app bin/rails db:encryption:init
AR_ENCRYPTION_PRIMARY_KEY=hyKh9GdYEZhqeF98knnfauioens9NVyV
AR_ENCRYPTION_DETERMINISTIC_KEY=NK3AFpyI1hrBWF6895z1i216YDAhFudj
AR_ENCRYPTION_KEY_DERIVATION_SALT=d5LQbkepzCQ0I5ju3wLX5ONks9YeN5q4

# --- Webhooks (W5) ---
# The origin GitHub delivers webhooks to, and the origin the "review in Prism"
# link in a pull request description points at. Blank is fine: without it the
# app runs normally and the /subscriptions screen explains what is missing.
#
# In development this is a tunnel hostname; in production, the app's own
# origin. Full setup, and why this is an env var rather than
# default_url_options, is in docs/webhooks.md.
#
#   docker compose --profile tunnel up -d tunnel
#   docker compose logs tunnel        # the URL, and every request as it lands
#
# With a static ngrok domain (see NGROK_AUTHTOKEN below) set this to that
# domain and the tunnel claims it every time, so the hostname never changes.
# Without one, ngrok assigns a random URL and you paste it here.
#
# If it ever changes, existing subscriptions show "Wrong address" on
# /subscriptions with a Re-register button — GitHub is otherwise still
# delivering to the old URL, silently.
PRISM_PUBLIC_URL=

# Where Prism puts its link. The description is a deliberate decision, not a
# default — see docs/webhooks.md and app/services/webhooks/announcement_target.rb.
PRISM_ANNOUNCEMENT_TARGET=description

# --- ngrok (the dev tunnel only) ---
# Needed ONLY by `docker compose --profile tunnel`, which is off by default.
# Nothing else in Prism reads it, and the app runs fine without it — you just
# can't receive webhooks from GitHub.
#
# Free account, no card: https://dashboard.ngrok.com/signup
# Token:                 https://dashboard.ngrok.com/get-started/your-authtoken
#
# Left blank, the tunnel refuses to start and says exactly this, rather than
# crash-looping.
NGROK_AUTHTOKEN=

# Optional. Defaults to PRISM_PUBLIC_URL, which is normally what you want.
# A free ngrok account includes one static domain — claim it at
# https://dashboard.ngrok.com/domains and set PRISM_PUBLIC_URL to it, and the
# tunnel will come back on the same URL every time. Only set NGROK_DOMAIN
# separately if the tunnel should claim a URL that is not PRISM_PUBLIC_URL.
NGROK_DOMAIN=
